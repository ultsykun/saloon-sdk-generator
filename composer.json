{
    "name": "azds/saloon-sdk-generator",
    "description": "Fork Simplified SDK Scaffolding for Saloon",
    "keywords": [
        "sdk generator",
        "saloon"
    ],
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Helge Sverre",
            "email": "helge.sverre@crescat.io"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-zip": "*",
        "cebe/php-openapi": "^1.7",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "laravel-zero/phar-updater": "^1.3",
        "nette/php-generator": "^4.0",
        "nunomaduro/termwind": "^1.15.1|^2.0",
        "saloonphp/laravel-plugin": "^3.2",
        "saloonphp/saloon": "^3.0",
        "spatie/laravel-data": "^3.10",
        "laravel-zero/framework": "^10.3.0",
        "laravel/pint": "^1.13"
    },
    "require-dev": {
        "mockery/mockery": "^1.5.1",
        "pestphp/pest": "^2.28.0"
    },
    "autoload": {
        "psr-4": {
            "Crescat\\SaloonSdkGenerator\\": "src/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1.29"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": [
        "codegen"
    ]
}
